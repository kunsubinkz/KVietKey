<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Authors>kunsubin</Authors>
    <Product>KVietKey</Product>
    <Copyright>© 2026 kunsubin</Copyright>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts/dotnet</ArtifactsPath>
    <!-- Phiên bản dùng chung với bản macOS: đọc từ ../VERSION -->
    <KVKVersion Condition="Exists('$(MSBuildThisFileDirectory)../VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../VERSION').Trim())</KVKVersion>
    <KVKVersion Condition="'$(KVKVersion)' == ''">1.0.0</KVKVersion>
    <Version>$(KVKVersion)</Version>
  </PropertyGroup>
</Project>
